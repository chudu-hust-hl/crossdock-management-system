# Copy this file to backend/.env for local development. Never commit .env.

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port of the API
PORT=3000

# MongoDB connection string.
# Matches the `mongodb` service in the root docker-compose.yml (host port 27018).
MONGODB_URI=mongodb://localhost:27018/cross_dock_management

# Shipment pricing rates in VND (see docs/business-workflows.md, "Cost").
# cost = round(BASE_FEE + FEE_PER_ITEM x item count + FEE_PER_KG x total weight in kg)
# The values below are EXAMPLES for local development only, not an agreed tariff.
# Set all three or none; with none set, POST /shipments answers 503.
PRICING_BASE_FEE=20000
PRICING_FEE_PER_ITEM=5000
PRICING_FEE_PER_KG=3000
